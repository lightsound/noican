<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>noican</string>
    <key>CFBundleDisplayName</key>
    <string>noican</string>
    <key>CFBundleIdentifier</key>
    <string>com.noican.menubar</string>
    <key>CFBundleExecutable</key>
    <string>NoicanMenuBar</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Menu bar only: no Dock icon, no app switcher entry. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Without this the microphone prompt never appears and Core Audio hands
         the callback silence, with no error anywhere to explain why. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>noican captures your microphone so it can remove background noise before other apps hear it. Audio never leaves this Mac.</string>
</dict>
</plist>
